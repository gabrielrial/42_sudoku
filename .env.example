# Copy to .env and fill in. .env is git-ignored and must never be committed.
#   cp .env.example .env

# Required: development, test or production. Nothing starts without it (D19).
APP_ENV=development

# Signs the session JWTs (DECISIONS.md D15): whoever has it can sign in as
# anyone. At least 32 random bytes. Generate one:  openssl rand -hex 32
SECRET_KEY=change-me

# Database. The compose file builds the container's URL from the parts below;
# this full URL is for running the backend outside Docker.
POSTGRES_USER=sudoku
POSTGRES_PASSWORD=sudoku
POSTGRES_DB=sudoku
POSTGRES_PORT=5442
DATABASE_URL=postgresql+psycopg://sudoku:sudoku@localhost:5442/sudoku

# Port the API is published on, on this machine. Change it if 8000 is taken.
API_PORT=8000

# Exact origin of the front end. Used for CORS and the CSRF origin check.
FRONTEND_ORIGIN=http://localhost:5173

# --- 42 OAuth (Phase 4; leave empty until then) -----------------------------
# Register an application at https://profile.intra.42.fr/oauth/applications
# The secret belongs here and nowhere else. Never in the repository, never in
# a chat, never in a screenshot.
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_REDIRECT_URI=http://localhost:8001/api/auth/callback

# Dev-only fake identity provider, so local work and CI never call 42.
# Refused when APP_ENV is "production". In fake mode, /api/auth/login?as=<login>
# signs in as that made-up user (D19).
AUTH_FAKE_PROVIDER_ENABLED=true

# Login attempts per IP per minute (DECISIONS.md D5).
LOGIN_ATTEMPTS_PER_MINUTE=5

# Today and the days after it that always have their puzzles (DECISIONS.md Q11).
PUZZLE_DAYS_AHEAD=7

# Session lifetimes (DECISIONS.md D15).
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Games (GAME_RULES.md §3; DECISIONS.md Q1, D5, D22).
# A game left from an earlier day closes after this many idle minutes, or this
# many minutes after the midnight that ended its day, whichever comes first.
GAME_INACTIVITY_MINUTES=15
GAME_ROLLOVER_GRACE_MINUTES=120
# A gap between two contacts longer than this is absence, not play.
GAME_ACTIVE_GAP_SECONDS=90
# Rate limits per game: inputs (a burst, then a rate), heartbeats, submissions.
GAME_INPUT_BURST=10
GAME_INPUTS_PER_SECOND=1
GAME_HEARTBEATS_PER_MINUTE=2
GAME_COMPLETIONS_PER_MINUTE=5
